{
  "cmake.useCMakePresets": "always",
  "cmake.cmakePath": "cube-cmake",
  "cmake.environment": {
    "PATH": "C:/ST/STM32CubeCLT_1.21.0/Ninja/bin;C:/ST/STM32CubeCLT_1.21.0/GNU-tools-for-STM32/bin;${env:PATH}"
  },
  "cortex-debug.armToolchainPath": "C:/ST/STM32CubeCLT_1.21.0/GNU-tools-for-STM32/bin",
  "C_Cpp.default.compilerPath": "C:/ST/STM32CubeCLT_1.21.0/GNU-tools-for-STM32/bin/arm-none-eabi-gcc.exe",
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",

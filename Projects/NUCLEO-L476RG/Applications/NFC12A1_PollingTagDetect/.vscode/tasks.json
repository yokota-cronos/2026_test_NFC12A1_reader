{
  "version": "2.0.0",
  "options": {
    "env": {
      "PATH": "C:\\ST\\STM32CubeCLT_1.21.0\\CMake\\bin;C:\\ST\\STM32CubeCLT_1.21.0\\Ninja\\bin;C:\\ST\\STM32CubeCLT_1.21.0\\GNU-tools-for-STM32\\bin;C:\\ST\\STM32CubeCLT_1.21.0\\STM32CubeProgrammer\\bin;${env:PATH}"
    }
  },
  "tasks": [
    {
      "label": "CMake Configure (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build/debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "dependsOn": ["CMake Configure (Debug)"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Flash (ST-Link)",
      "type": "shell",
      "command": "STM32_Programmer_CLI",
      "args": [
        "-c", "port=SWD", "mode=UR",
        "-w", "${workspaceFolder}/build/debug/NFC12A1_PollingTagDetect.elf",
        "-v", "-rst"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build & Flash",
      "dependsOrder": "sequence",
      "dependsOn": ["Build (Debug)", "Flash (ST-Link)"],
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build/debug", "--target", "clean"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
